<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>.NET wrapper for libmagic, bundling native libmagic binaries for Windows, Linux and macOS. Fork of hey-red/Mime.</Description>
    <AssemblyTitle>Mime</AssemblyTitle>
    <Version>4.0.0</Version>
    <Authors>red;si618</Authors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>MimeMagic</PackageId>
    <PackageTags>mime;mimetype;libmagic</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/si618/Mime</PackageProjectUrl>
    <RepositoryUrl>https://github.com/si618/Mime</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>Mime</AssemblyName>
    <RootNamespace>HeyRed.Mime</RootNamespace>
    <Platforms>AnyCPU;ARM64;x64;x86</Platforms>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Runtime.InteropServices" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="MimeTypesMap" />
  </ItemGroup>
    
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="runtimes\win-x64\native\*" PackagePath="runtimes/win-x64/native/" Pack="true" />
    <None Include="runtimes\win-x86\native\*" PackagePath="runtimes/win-x86/native/" Pack="true" />
    <None Include="runtimes\win-arm64\native\*" PackagePath="runtimes/win-arm64/native/" Pack="true" />
    <None Include="runtimes\linux-x64\native\*" PackagePath="runtimes/linux-x64/native/" Pack="true" />
    <None Include="runtimes\linux-arm64\native\*" PackagePath="runtimes/linux-arm64/native/" Pack="true" />
    <None Include="runtimes\linux-musl-x64\native\*" PackagePath="runtimes/linux-musl-x64/native/" Pack="true" />
    <None Include="runtimes\linux-musl-arm64\native\*" PackagePath="runtimes/linux-musl-arm64/native/" Pack="true" />
    <None Include="runtimes\osx-x64\native\*" PackagePath="runtimes/osx-x64/native/" Pack="true" />
    <None Include="runtimes\osx-arm64\native\*" PackagePath="runtimes/osx-arm64/native/" Pack="true" />
    
    <None Include="content\*" PackagePath="runtimes/win-x64/native/" Pack="true" />
    <None Include="content\*" PackagePath="runtimes/win-x86/native/" Pack="true" />
    <None Include="content\*" PackagePath="runtimes/win-arm64/native/" Pack="true" />
    <None Include="content\*" PackagePath="runtimes/linux-x64/native/" Pack="true" />
    <None Include="content\*" PackagePath="runtimes/linux-arm64/native/" Pack="true" />
    <None Include="content\*" PackagePath="runtimes/linux-musl-x64/native/" Pack="true" />
    <None Include="content\*" PackagePath="runtimes/linux-musl-arm64/native/" Pack="true" />
    <None Include="content\*" PackagePath="runtimes/osx-x64/native/" Pack="true" />
    <None Include="content\*" PackagePath="runtimes/osx-arm64/native/" Pack="true" />
      
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Properties\**" />
    
    <!-- NuGet only auto-imports build assets named after the PackageId -->
    <None Include="Mime.props" PackagePath="build/MimeMagic.props" Pack="true" />
  </ItemGroup>

</Project>

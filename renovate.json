{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "automerge": false,
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["nuget"],
      "automerge": false,
      "groupName": "NuGet packages"
    },
    {
      "matchManagers": ["docker-compose", "dockerfile"],
      "automerge": false,
      "groupName": "Docker images"
    },
    {
      "description": "dotnet-version in the workflows installs the net8.0 test runtime; global.json picks the SDK. Remove when net8.0 is dropped.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["dotnet-sdk"],
      "enabled": false
    }
  ]
}

# Kept to what this repo produces, rather than the full `dotnet new gitignore` template.

# Build output (UseArtifactsOutput), with bin/obj as a fallback for tools that ignore it
artifacts/
[Bb]in/
[Oo]bj/

# Test and pack output
[Tt]est[Rr]esults/
nupkg/
*.binlog

# IDEs
.vs/
.idea/
*.user
*.suo
*.DotSettings.user

# OS
.DS_Store
Thumbs.db

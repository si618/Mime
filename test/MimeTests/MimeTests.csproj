<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- CA1707 (no underscores in member names) contradicts the test-naming convention
         UnitOfWork_Scenario_ExpectedBehaviour. The convention wins in tests; CA1707 still
         applies to shipping code. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <Platforms>AnyCPU;ARM64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="HeyRed.Mime" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mime\Mime.csproj" />
  </ItemGroup>

  <ImportGroup>
    <Import Project="..\..\src\Mime\Mime.props" />
  </ImportGroup>
  
  <!-- Windows -->
  <ItemGroup Condition=" '$(IsX64)' == 'true' AND '$(IsWindows)' == 'true' ">
    <NativeLib Include="../../src/Mime/runtimes/win-x64/native/*" />
  </ItemGroup>
  <ItemGroup Condition=" '$(IsARM64)' == 'true' AND '$(IsWindows)' == 'true' ">
    <NativeLib Include="../../src/Mime/runtimes/win-arm64/native/*" />
  </ItemGroup>
  <ItemGroup Condition=" '$(IsX64)' != 'true' AND '$(IsARM64)' != 'true' AND '$(IsWindows)' == 'true' ">
    <NativeLib Include="../../src/Mime/runtimes/win-x86/native/*" />
  </ItemGroup>

  <!-- Linux -->
  <ItemGroup Condition=" '$(IsX64)' == 'true' AND '$(IsLinux)' == 'true' ">
    <NativeLib Include="../../src/Mime/runtimes/linux-x64/native/*" />
  </ItemGroup>
  <ItemGroup Condition=" '$(IsARM64)' == 'true' AND '$(IsLinux)' == 'true' ">
    <NativeLib Include="../../src/Mime/runtimes/linux-arm64/native/*" />
  </ItemGroup>

  <!-- OSX arm64 -->
  <ItemGroup Condition=" '$(IsARM64)' == 'true' AND '$(IsOSX)' == 'true' ">
    <NativeLib Include="../../src/Mime/runtimes/osx-arm64/native/*" />
  </ItemGroup>
  
  <!-- OSX x64 -->
  <ItemGroup Condition=" '$(IsX64)' == 'true' AND '$(IsOSX)' == 'true' ">
    <NativeLib Include="../../src/Mime/runtimes/osx-x64/native/*" />
  </ItemGroup>

  <Target Name="CopyNativeLib" AfterTargets="Build">
    <Copy SourceFiles="@(NativeLib)" DestinationFolder="$(OutputPath)" />
    <Copy SourceFiles="../../src/Mime/content/magic.mgc" DestinationFolder="$(OutputPath)" />
  </Target>

  <ItemGroup>
    <None Include="TestData/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PrintRID" BeforeTargets="Build">
    <Message Text="IsWindows $(IsWindows)" Importance="high" />
    <Message Text="IsOSX $(IsOSX)" Importance="high" />
    <Message Text="IsLinux $(IsLinux)" Importance="high" />
    <Message Text="IsArm64 $(IsARM64)" Importance="high" />
    <Message Text="IsX64 $(IsX64)" Importance="high" />
  </Target>

</Project>

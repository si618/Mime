<!-- Central Package Management: every PackageReference in the repo takes its version from here. -->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Library">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="MimeTypesMap" Version="1.0.9" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.257" />
  </ItemGroup>

  <!-- No Microsoft.Testing.Platform entry: xunit.v3 carries its own compatible version, and
       pinning MTP separately overrides it via transitive pinning into a runtime TypeLoadException. -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
